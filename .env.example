# ==============================================================================
# NEXUS Environment Configuration Template
# ==============================================================================
# Usage:
#   1. Copy this template to create your local '.env' file:
#        cp .env.example .env
#   2. Generate and set a strong, unique secret password for POSTGRES_PASSWORD:
#        e.g. openssl rand -hex 32
#
# SECURITY NOTICES:
#   - Never commit actual '.env' files or credentials to version control.
#   - Docker Compose enforces mandatory validation: startup will fail if
#     POSTGRES_PASSWORD is blank or unset.
#   - In Docker Compose, DATABASE_URL automatically uses the credentials
#     configured in POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB with safe URL escaping.
# ==============================================================================

# --- PostgreSQL Database Credentials (Mandatory) ---
POSTGRES_USER=nexus_user
# REQUIRED: Replace with a strong, randomly-generated secret password before starting.
# Startup will fail if left blank or unset. Recommended: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=nexus_db

# --- Database Connection URL ---
# In Docker Compose, the backend automatically constructs DATABASE_URL over the
# internal network from POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB with safe URL encoding.
# Only uncomment and set DATABASE_URL if you need an external or custom connection string:
# DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- Application Runtime Environment ---
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Network & Host Port Bindings (Restricted to loopback 127.0.0.1 by default) ---
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000

# Prometheus UI Host Binding (127.0.0.1 by default; change or disable in production)
PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090

# --- CORS Allowed Origins ---
NEXUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
